<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navigation"
    app:startDestination="@id/navigation_home">
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.fragmentexample.feature.home.HomeFragment"
        android:label="@string/home">
        <action
            android:id="@+id/action_home_to_slide_page"
            app:destination="@id/navigation_slide_page"
            app:enterAnim="@anim/slide_in_bottom"
            app:exitAnim="@anim/stay"
            app:popEnterAnim="@anim/stay"
            app:popExitAnim="@anim/slide_out_bottom" />
    </fragment>
    <fragment
        android:id="@+id/navigation_slide_page"
        android:name="com.example.fragmentexample.feature.slide.SlidePageFragment"
        android:label="@string/slide_page_title" />
</navigation>
